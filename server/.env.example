# ==============================================================================
# Turium AI Knowledge Inbox — Environment Configuration
# ==============================================================================

# Server Port
PORT=3001

# Node Environment: development | production | test
NODE_ENV=development

# SQLite Database Location (defaults to data/inbox.db)
DATABASE_PATH=./data/inbox.db

# AI Operating Mode: live | demo
# live = Uses Google Gemini embeddings + Groq LLM (requires GEMINI_API_KEY and GROQ_API_KEY)
# demo = Offline deterministic local embeddings + extractive synthesizer (no API keys required)
AI_MODE=live

# Google Gemini API Key (Required for live embeddings)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for live grounded answers)
# Get a free key at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Gemini Embedding Model (preferred: gemini-embedding-001)
EMBEDDING_MODEL=gemini-embedding-001

# Gemini Embedding Dimensions (768 via Matryoshka Representation Learning)
EMBEDDING_DIMENSIONS=768

# Groq Chat Completion Model (e.g. openai/gpt-oss-120b, llama-3.3-70b-versatile, or llama-3.1-8b-instant)
CHAT_MODEL=openai/gpt-oss-120b
