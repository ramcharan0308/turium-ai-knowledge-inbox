# Server Port
PORT=3001

# Node Environment: development | production | test
NODE_ENV=development

# SQLite Database Location (defaults to data/inbox.db)
DATABASE_PATH=./data/inbox.db

# OpenAI API Key (Required for live vector embeddings & grounded RAG)
# Do NOT enter production secrets here. Copy this file to .env and configure.
OPENAI_API_KEY=your_openai_api_key_here

# Vector Embedding Model (1536 dimensions)
EMBEDDING_MODEL=text-embedding-3-small

# Chat Completion Model for Grounded Answers
CHAT_MODEL=gpt-4o-mini

# Explicit Mock Mode toggle (false = use OpenAI credentials, true = explicit offline test mode)
# NOTE: Missing credentials will NOT silently activate mock mode.
USE_EXPLICIT_MOCK_MODE=false
